// Utils
import { getImage } from "astro:assets";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import FAQ from "@components/FAQ/FAQ.astro";
import CTA from "@components/CTA/CTASimple.astro";

// TODO: import service-specific banner image
// import bannerImage from "@assets/images/banners/<your-service>.png";

// TODO: substitua pelo banner real acima; o placeholder recua para landing.jpg
import bannerImage from "@assets/images/landing.jpg";

const optimizedImage = await getImage({ src: bannerImage, format: "webp" });

// TODO: fill in service-specific metadata
const service = {
		title: "Nome do Serviço",
		bannerDescription: "Frase curta que aparece por baixo do título do banner.",
	seoDescription:
			"Meta description SEO - 140 a 160 caracteres a apresentar este serviço para clientes em Lisboa.",
};
---

<BaseLayout title={service.title} description={service.seoDescription} heroImage={optimizedImage}>
	<Banner
		title={service.title}
		description={service.bannerDescription}
		image={optimizedImage}
	/>

