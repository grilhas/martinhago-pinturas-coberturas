---
// Utils
import { getImage } from "astro:assets";

// Components
import BaseLayout from "@layouts/BaseLayout.astro";
import Banner from "@components/Banner/Banner.astro";
import ReviewsSection from "@components/Reviews/Reviews.astro";
import CTA from "@components/CTA/CTASimple.astro";

// Images
import landingImage from "@assets/images/pinturas/fachadas-coloridas-ceu.jpg";
const optimizedImage = await getImage({ src: landingImage, format: "webp" });
---

<BaseLayout
	title="Testemunhos | Martinhago Pinturas & Coberturas"
	description="Testemunhos de clientes da Martinhago Pinturas & Coberturas em Lisboa e região."
	heroImage={optimizedImage}
>
	<Banner
		title="Testemunhos"
		description="O que dizem os clientes sobre trabalhos de pintura e coberturas feitos pela Martinhago."
		image={optimizedImage}
	/>
	<ReviewsSection />
	<CTA />
</BaseLayout>
