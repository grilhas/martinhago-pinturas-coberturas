---
/**
 * * Simplified CTA component using Astro's built-in Picture component
 **/

// Utils
import { Picture } from "astro:assets";

// Images
import ctaImage from "@assets/images/site/truck-2.webp";
---

<!-- ============================================ -->
<!--                  Contact                     -->
<!-- ============================================ -->

<section id="contact-1970">
    <div class="cs-container">
        <div class="cs-content">
            <h2 class="cs-title">Have a Question?</h2>
            <p class="cs-text">
                Reach out today. A member of our team will be in contact with you within 24-hours of your submission.
            </p>
        </div>
        <div class="cs-right">
            <!--Form-->
            <form class="cs-form" id="cs-form-1970" name="CTA Contact" method="post" {...{ netlify: "" }}>
                <input type="hidden" name="form-name" value="CTA Contact" />
                <label class="cs-label">
                    First Name
                    <input class="cs-input" required type="text" id="first-name-1970" name="first name">
                </label>
                <label class="cs-label">
                    Last Name
                    <input class="cs-input" required type="text" id="last-name-1970" name="last name">
                </label>
                <label class="cs-label">
                    Email
                    <input class="cs-input" required type="email" id="email-1970" name="email">
                </label>
                <button class="cs-button-solid cs-submit" type="submit">Reach Out</button>
            </form>
        </div>
    </div>
    <!-- Background Image, added in CSS as a background image for parallax effect -->
    <Picture 
        src={ctaImage}
        alt=""
        layout="full-width"
        formats={["avif", "webp"]}
        pictureAttributes={{ class: "cs-background" }}
    />
</section>
                                
<style lang="less">
/*-- -------------------------- -->
<---         Contact            -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
    #contact-1970 {
        padding: var(--sectionPadding);
        overflow: hidden;
        position: relative;
        z-index: 1;

        .cs-container {
            width: 100%;
            /* changes to 1280px at desktop */
            max-width: (704/16rem);
            margin: auto;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            /* 40px - 80px */
            gap: clamp(2.5rem, 5vw, 5rem);
        }

        .cs-content {
            text-align: center;
            width: 100%;
            max-width: (622/16rem);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            flex-wrap: wrap;
        }

        .cs-title {
            max-width: (829/16rem);
            color: #fff;
        }

        .cs-text {
            color: #f7f7f7;
        }

        .cs-right {
            text-align: center;
            width: 100%;
            box-sizing: border-box;
            padding: (24/16rem);
            background-color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            z-index: 1;
        }

        .cs-form {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            column-gap: clamp(1rem, 2vw, 1.25rem);
            row-gap: (12/16rem);
        }

        .cs-label {
            font-size: (14/16rem);
            width: 100%;
            color: #767676;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            gap: (4/16rem);
        }

        .cs-input, select {
            font-size: (16/16rem);
            width: 100%;
            height: (56/16rem);
            /* prevents padding from adding to height and width */
            box-sizing: border-box;
            padding: 0;
            padding-left: (24/16rem);
            background-color: #f7f7f7;
            color: var(--bodyTextColor);
            border: none;
            transition: border-color 0.3s;

            &:hover {
                border-color: var(--secondary);
            }

            &:focus {
                outline: 1px solid var(--secondary);
            }

            &::placeholder {
                color: #7d799c;
                opacity: 0.6;
            }
        }

        .cs-textarea {
            font-family: inherit;
            min-height: (95/16rem);
            margin-bottom: (12/16rem);
            padding-top: (24/16rem);
        }

        .cs-button-solid {
            font-size: (16/16rem);
            font-weight: 700;
            /* 46px - 56px */
            line-height: clamp(2.875rem, 5.5vw, 3.5rem);
            text-align: center;
            text-decoration: none;
            min-width: (200/16rem);
            margin: 0;
            /* prevents padding from adding to the width */
            box-sizing: border-box;
            padding: 0 (24/16rem);
            background-color: var(--primary);
            overflow: hidden;
            color: #fff;
            display: inline-block;
            position: relative;
            z-index: 1;

            &:before {
                content: "";
                width: 0%;
                height: 100%;
                background: #000;
                opacity: 1;
                position: absolute;
                top: 0;
                left: 0;
                z-index: -1;
                transition: width 0.3s;
            }

            &:hover {
                &:before {
                    width: 100%;
                }
            }
        }

        .cs-submit {
            width: 100%;
            margin: (24/16rem) 0 0 0;
            border: none;

            &:hover {
                cursor: pointer;
            }
        }

        .cs-background {
            width: 100%;
            height: 100%;
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            z-index: -2;

            &:before {
                /* Overlay — dark on the left for text legibility, fades out toward the form */
                content: "";
                width: 100%;
                height: 100%;
                background: linear-gradient(to right, #000 0%, rgba(0, 0, 0, 0.6) 45%, rgba(0, 0, 0, 0) 82%);
                /* prevents the cursor from interacting with it */
                pointer-events: none;
                opacity: 1;
                display: block;
                position: absolute;
                top: 0;
                left: 0;
                z-index: 1;
            }

            img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                position: absolute;
                top: 0;
                left: 0;
            }
        }
    }
}

/* Tablet - 768px */
@media only screen and (min-width: 48rem) {
    #contact-1970 {
        .cs-right {
            max-width: (578/16rem);
            padding: (48/16rem) (32/16rem);
        }

        .cs-form {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
        }

        .cs-label {
            grid-column: span 12;

            &:nth-of-type(1), &:nth-of-type(2), 
            &:nth-of-type(3), &:nth-of-type(4),
            &:nth-of-type(5), &:nth-of-type(6) {
                grid-column: span 6;
            }
        }

        .cs-submit {
            grid-column: span 12;
        }
    }
}

/* Desktop - 1024px */
@media only screen and (min-width: 64rem) {
    #contact-1970 {
        .cs-container {
            max-width: (1280/16rem);
            flex-direction: row;
            justify-content: space-between;
            flex-wrap: nowrap;
        }

        .cs-title {
            margin-left: 0;
        }

        .cs-content {
            text-align: left;
            align-items: flex-start;
        }
    }
}

/* Dark Mode */
@media only screen and (min-width: 0rem) {
    body.dark-mode {
        #contact-1970 {
            .cs-right {
                background-color: var(--medium);
            }

            .cs-label {
                color: var(--bodyTextColorWhite);
            }

            .cs-input, select {
                background-color: rgba(255, 255, 255, .1);
                color: var(--bodyTextColorWhite);
            }
        }
    }
}
                                
</style>