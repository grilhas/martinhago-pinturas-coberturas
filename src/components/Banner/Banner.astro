---
/**
 * * Banner used on every page except the homepage.
 * * Pass a pre-optimized image from `getImage()`. Sharp handles format conversion there.
 */

// Utils
import type { GetImageResult } from "astro";

interface Props {
  title: string; // heading text
  image: GetImageResult; // pre-optimized image from getImage()
  description?: string; // optional subtitle under the heading
}

const { title, image, description } = Astro.props;
---

<div id="banner-2285">
  <!--Background Image-->
  <picture class="cs-background">
    <img
      src={image.src}
      alt=""
      width={image.attributes.width}
      height={image.attributes.height}
      aria-hidden="true"
      loading="eager"
      decoding="async"
    />
  </picture>

  <div class="cs-top">
    <div class="cs-container">
      <span class="cs-int-title">{title}</span>
      {description && <p class="cs-text">{description}</p>}
    </div>
  </div>

  <div class="cs-breadcrumbs">
    <div class="cs-breadcrumbs-inner">
      <a href="/" class="cs-link">Início</a>
      <span class="cs-divider" aria-hidden="true"></span>
      <span class="cs-link cs-active">{title}</span>
    </div>
  </div>
</div>

<style lang="less">
  /*-- -------------------------- -->
<---          Banner            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #banner-2285 {
      /* no horizontal padding — bg image and breadcrumb bar extend edge-to-edge */
      padding: 0;
      /* ensure the banner has a meaningful height so breadcrumbs sit at the bottom */
      min-height: clamp(20rem, 50vw, 36rem);
      overflow: hidden;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
    }

    #banner-2285 .cs-top {
      /* flex:1 pushes breadcrumbs to the bottom */
      flex: 1;
      width: 100%;
      /* prevents padding from affecting height and width */
      box-sizing: border-box;
      /* 190px - 280px top for nav clearance */
      padding: clamp(11.875rem, 25vw, 17.5rem) 1rem clamp(2rem, 4vw, 4rem);
      display: flex;
      align-items: flex-end;
    }

    #banner-2285 .cs-container {
      width: 100%;
      max-width: (1280/16rem);
      margin: auto;
      text-align: left;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: (16/16rem);
    }

    #banner-2285 .cs-int-title {
      /* 39px - 61px */
      font-size: clamp(2.4375rem, 6.4vw, 3.8125rem);
      font-family: var(--headerFont);
      font-weight: 700;
      line-height: 1.2em;
      text-transform: uppercase;
      text-align: inherit;
      margin: 0;
      max-width: (699/16rem);
      color: var(--bodyTextColorWhite);
      position: relative;
    }

    #banner-2285 .cs-text {
      text-align: left;
      margin: 0;
      max-width: (699/16rem);
      color: var(--bodyTextColorWhite);
      font-family: var(--bodyFont);
    }

    #banner-2285 .cs-breadcrumbs {
      /* full-width strip at the bottom of the banner */
      width: 100%;
      padding: clamp(1rem, 1.5vw, 1.5rem) 0;
      background-color: rgba(255, 255, 255, 0.12);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
      display: flex;
      justify-content: center;
      align-items: center;
    }

    #banner-2285 .cs-breadcrumbs-inner {
      width: 100%;
      max-width: (1280/16rem);
      /* prevents padding from affecting height and width */
      box-sizing: border-box;
      margin: 0 auto;
      padding: 0 1rem;
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: (16/16rem);
    }

    #banner-2285 .cs-link {
      font-size: (16/16rem);
      font-family: var(--headerFont);
      line-height: 1.5em;
      text-decoration: none;
      color: var(--bodyTextColorWhite);
      display: inline-flex;
      align-items: center;
    }

    #banner-2285 a.cs-link {
      /* O link de início usa o destaque da marca */
      color: var(--primary);
      transition: opacity 0.3s;

      &:hover {
        opacity: 0.8;
      }
    }

    #banner-2285 .cs-divider {
      width: 1px;
      height: (24/16rem);
      background-color: #88898b;
      display: block;
      flex-shrink: 0;
    }

    #banner-2285 .cs-background {
      width: 100%;
      height: 100%;
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;

      &:before {
        /* dark brand overlay so text stays readable over any image */
        content: "";
        width: 100%;
        height: 100%;
        background: linear-gradient(
          -90deg,
          rgba(15, 17, 19, 0) 6.43%,
          rgba(15, 17, 19, 0.9) 69.01%
        );
        position: absolute;
        display: block;
        top: 0;
        left: 0;
        z-index: 1;
      }

      img {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
        z-index: -1;
      }
    }
  }

  /* Dark Mode — deepen the gradient so the banner reads dark-consistent */
  @media only screen and (min-width: 0rem) {
    body.dark-mode {
      #banner-2285 {
        .cs-background {
          &:before {
            /* near-black overlay, less transparent than light-mode navy */
            background: linear-gradient(
              -90deg,
              rgba(0, 0, 0, 0.15) 6.43%,
              rgba(0, 0, 0, 0.92) 69.01%
            );
          }
        }
      }
    }
  }
</style>
